# Copy to .env for local dev. In production this lives at /etc/irlos-web.env,
# mode 600, loaded by systemd. Real values never go in the repo.

# Stripe secret key. sk_test_... locally, sk_live_... in production.
STRIPE_SECRET_KEY=

# Webhook signing secret. From `stripe listen` locally, from the dashboard
# webhook endpoint in production.
STRIPE_WEBHOOK_SECRET=

# Price ids from the Stripe dashboard. Prices live in Stripe, nowhere else.
# cloud: $30/mo recurring. backpack full: $1,000 one time. deposit: $99 one time.
STRIPE_PRICE_CLOUD=
STRIPE_PRICE_BACKPACK_FULL=
STRIPE_PRICE_BACKPACK_DEPOSIT=

# Public origin, no trailing slash. Checkout redirects land here.
SITE_URL=https://irlos.live

# Basic auth for /admin. Pick a long random password.
ADMIN_USER=
ADMIN_PASS=

# Where purchase alerts go. Cloud provisioning is manual, this alert is the trigger.
OPERATOR_EMAIL=

# Local postfix on ethanmanners.com. Leave SMTP_USER and SMTP_PASS empty when
# the relay accepts localhost without auth.
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=

# SQLite file, relative to the working directory. systemd allows writes
# only under /opt/irlos-web/data.
DB_PATH=data/irlos.db

# Port the node process binds on 127.0.0.1. nginx proxies /api/ here.
PORT=8787

# --- chat reader (/tts) ---------------------------------------------------
# piper by default with the hfc_female medium voice. Both paths default to the
# /opt/piper layout the box uses, so production needs neither line; set them
# on a dev machine that unpacked piper somewhere else. Unpack the release
# whole: the binary finds its bundled libraries through an $ORIGIN runpath.
PIPER_BIN=/opt/piper/piper
PIPER_MODEL=/opt/piper/voices/en_US-hfc_female-medium.onnx

# Reading speed. Below 1 is faster, above 1 is slower, the model default is 1.
PIPER_LENGTH_SCALE=1

# Concurrent channels. Defaults to 1 under piper, which holds 143MB and half
# of this box's only core per session, and 8 under espeak-ng. Listeners on one
# channel share its session and are capped separately.
TTS_MAX_SESSIONS=1

# TTS_ENGINE=espeak-ng falls back to mbrola, no model file needed. TTS_VOICE
# picks the mbrola voice: mb-us1 female, mb-us2 and mb-us3 male.
TTS_ENGINE=piper
TTS_VOICE=mb-us1
