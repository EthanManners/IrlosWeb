# Copy to .env for local dev. In production this lives at /etc/irlos-web.env,
# mode 600, loaded by systemd. Real values never go in the repo.

# Stripe secret key. sk_test_... locally, sk_live_... in production.
STRIPE_SECRET_KEY=

# Webhook signing secret. From `stripe listen` locally, from the dashboard
# webhook endpoint in production.
STRIPE_WEBHOOK_SECRET=

# Price ids from the Stripe dashboard. Prices live in Stripe, nowhere else.
# cloud: $30/mo recurring. backpack full: $1,000 one time. deposit: $99 one time.
STRIPE_PRICE_CLOUD=
STRIPE_PRICE_BACKPACK_FULL=
STRIPE_PRICE_BACKPACK_DEPOSIT=

# Public origin, no trailing slash. Checkout redirects land here.
SITE_URL=https://irlos.live

# Basic auth for /admin. Pick a long random password.
ADMIN_USER=
ADMIN_PASS=

# Where purchase alerts go. Cloud provisioning is manual, this alert is the trigger.
OPERATOR_EMAIL=

# Local postfix on ethanmanners.com. Leave SMTP_USER and SMTP_PASS empty when
# the relay accepts localhost without auth.
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=

# SQLite file, relative to the working directory. systemd allows writes
# only under /opt/irlos-web/data.
DB_PATH=data/irlos.db

# Port the node process binds on 127.0.0.1. nginx proxies /api/ here.
PORT=8787
